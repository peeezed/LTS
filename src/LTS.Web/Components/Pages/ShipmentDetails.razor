@page "/{CountryCode}/shipment-details"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout AppLayout
@inherits CountryPageBase
@inject IShipmentQueryService Query
@inject IIntegrationMilestoneService Milestones
@inject ISnackbar Snackbar

<PageTitle>Shipment details · LTS</PageTitle>

<AppShell>
@if (!Ready)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h5">Shipment Details</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @(CanEdit ? "Enter the dates your company is responsible for" : "Read-only view")
        </MudText>
    </MudStack>

    @if (_errors.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Some dates were not saved</MudText>
            <ul class="ma-0 pl-4">
                @foreach (var error in _errors)
                {
                    <li>@error.Message</li>
                }
            </ul>
        </MudAlert>
    }

    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            No shipment with that reference exists in @Country.Current!.Name, or it is not one of yours.
        </MudAlert>
    }

    <MudDataGrid T="ShipmentRow" @ref="_grid" ServerData="LoadGridAsync" Dense="true" Hover="true" Striped="true"
                 Filterable="false" SortMode="SortMode.Single" RowsPerPage="25" Elevation="1"
                 FixedHeader="true" Height="calc(100vh - 380px)" Class="mb-3">
        <Columns>
            <TemplateColumn Title="Reference No" SortBy="x => x.ReferenceNo">
                <CellTemplate>
                    <MudLink Underline="Underline.Hover" Style="cursor: pointer;"
                             OnClick="@(() => OpenAsync(context.Item.ReferenceNo))">
                        @context.Item.ReferenceNo
                    </MudLink>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.InvoiceNo" Title="Invoice No" />
            <PropertyColumn Property="x => x.InvoiceDate" Title="Invoice Date" Format="yyyy-MM-dd" />

            <TemplateColumn Title="Status" SortBy="x => x.CurrentStatus">
                <CellTemplate><StatusChip Status="context.Item.CurrentStatus" /></CellTemplate>
            </TemplateColumn>

            @foreach (var milestone in VisibleShipmentMilestones)
            {
                <TemplateColumn Title="@milestone.DisplayName" Sortable="false"
                                 HeaderStyle="min-width: 230px;" CellStyle="min-width: 230px;">
                    <CellTemplate>
                        <MudDatePicker Date="@GridGet(context.Item, milestone.Type)"
                                       DateChanged="@(date => GridSet(context.Item, milestone.Type, date))"
                                       ReadOnly="@(!Permissions.CanEditMilestone(milestone.Type, CountryId))"
                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                       DateFormat="yyyy-MM-dd" Clearable="true"
                                       Class="shipment-date-picker" />
                    </CellTemplate>
                </TemplateColumn>
            }

            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudTooltip Text="View full details">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                       OnClick="@(() => OpenAsync(context.Item.ReferenceNo))" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ShipmentRow" PageSizeOptions="new[] { 25, 50, 100 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4">No shipments to show.</MudText>
        </NoRecordsContent>
    </MudDataGrid>

    @if (CanEdit)
    {
        <MudStack Row="true" Spacing="2" Class="mb-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                       StartIcon="@Icons.Material.Filled.Save" Disabled="@(_busy || !HasChanges)">
                Save dates
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="ResetChanges" Disabled="@(!HasChanges)">
                Discard changes
            </MudButton>
            @if (HasChanges)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary align-self-center">
                    @_edits.Count unsaved change@(_edits.Count == 1 ? "" : "s")
                </MudText>
            }
        </MudStack>
    }

    @if (_shipment is not null)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h6">@_shipment.ReferenceNo</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Invoice @_shipment.InvoiceNo · @_shipment.InvoiceDate.ToString("yyyy-MM-dd")
                    </MudText>
                    <MudStack Row="true" Spacing="2" Class="mt-2">
                        <StatusChip Status="_shipment.CurrentStatus" />
                        <PerformanceChip Performance="_shipment.Performance" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudStack Row="true" Justify="Justify.SpaceEvenly">
                        <Stat Label="Transfers" Value="@_shipment.TransferCount.ToString("N0")" />
                        <Stat Label="Boxes" Value="@_shipment.TotalBoxes.ToString("N0")" />
                        <Stat Label="Items" Value="@_shipment.TotalItems.ToString("N0")" />
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />

            <MudGrid Spacing="2">
                <Attribute Label="Arrival Country" Value="@_shipment.ArrivalCountry" />
                <Attribute Label="Arrival Customs" Value="@_shipment.ArrivalCustoms" />
                <Attribute Label="Export Type" Value="@_shipment.ExportType" />
                <Attribute Label="Transport Type" Value="@_shipment.TransportType" />
                <Attribute Label="Loading Point" Value="@_shipment.LoadingPoint" />
                <Attribute Label="Logistics Company" Value="@_shipment.LogisticsCompany" />
                <Attribute Label="Broker" Value="@_shipment.Broker" />
            </MudGrid>
        </MudPaper>

        @if (VisibleTransferMilestones.Count > 0 && _shipment.Transfers.Count > 0)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-1">Transfer dates</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                    Normally supplied by the warehouse integration; enter them here when it has not delivered.
                </MudText>

                @foreach (var transfer in _shipment.Transfers)
                {
                    <MudExpansionPanels Elevation="0" Class="mb-2">
                        <MudExpansionPanel Text="@($"{transfer.TransferNo} · {transfer.Receiver}")">
                            <MudGrid Spacing="2">
                                @foreach (var milestone in VisibleTransferMilestones)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudDatePicker Label="@milestone.DisplayName"
                                                       Date="@TransferGet(transfer.TransferNo, milestone.Type)"
                                                       DateChanged="@(date => TransferSet(transfer.TransferNo, milestone.Type, date))"
                                                       ReadOnly="@(!Permissions.CanEditMilestone(milestone.Type, CountryId))"
                                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       DateFormat="yyyy-MM-dd" Clearable="true" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            </MudPaper>
        }
    }
}
</AppShell>

@code {
    protected override string PageKey => PageKeys.ShipmentDetails;

    [SupplyParameterFromQuery(Name = "reference")]
    private string? ReferenceFromQuery { get; set; }

    private MudDataGrid<ShipmentRow>? _grid;
    private string? _reference;
    private ShipmentDetail? _shipment;
    private bool _notFound;
    private bool _busy;

    // Pending edits, keyed by reference number (shipment milestones) or transfer number
    // (transfer milestones) and the milestone type. Independent of the grid page or whichever
    // shipment happens to be open below, so edits survive paging and opening other shipments.
    private readonly Dictionary<(string Reference, MilestoneType Type), DateOnly?> _edits = [];
    private List<MilestoneError> _errors = [];

    private bool HasChanges => _edits.Count > 0;

    private IReadOnlyList<MilestoneDefinition> VisibleShipmentMilestones =>
        [.. MilestoneCatalog.ShipmentMilestones.Where(m => Permissions.CanViewMilestone(m.Type))];

    private IReadOnlyList<MilestoneDefinition> VisibleTransferMilestones =>
        [.. MilestoneCatalog.TransferMilestones.Where(m => Permissions.CanViewMilestone(m.Type))];

    protected override async Task OnCountryReadyAsync()
    {
        if (_grid is not null)
        {
            await _grid.ReloadServerData();
        }

        if (!string.IsNullOrWhiteSpace(ReferenceFromQuery))
        {
            await OpenAsync(ReferenceFromQuery);
        }
    }

    private async Task<GridData<ShipmentRow>> LoadGridAsync(GridState<ShipmentRow> state)
    {
        var sort = state.SortDefinitions.FirstOrDefault();

        var result = await Query.GetShipmentsAsync(
            CountryId,
            Permissions,
            new ShipmentFilter(),
            new GridRequest(state.Page, state.PageSize, sort?.SortBy, sort?.Descending ?? false));

        return new GridData<ShipmentRow> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OpenAsync(string referenceNo)
    {
        _reference = referenceNo;
        _busy = true;

        _shipment = await Query.GetShipmentDetailAsync(CountryId, Permissions, referenceNo);
        _notFound = _shipment is null;
        _busy = false;
    }

    /// <summary>Current value for a shipment-level field: the pending edit, or what the grid loaded.</summary>
    private DateTime? GridGet(ShipmentRow row, MilestoneType type)
    {
        if (_edits.TryGetValue((row.ReferenceNo, type), out var edited))
        {
            return edited?.ToDateTime(TimeOnly.MinValue);
        }

        return StoredDate(row, type)?.ToDateTime(TimeOnly.MinValue);
    }

    private void GridSet(ShipmentRow row, MilestoneType type, DateTime? value)
    {
        var newValue = value is null ? (DateOnly?)null : DateOnly.FromDateTime(value.Value);

        if (StoredDate(row, type) == newValue)
        {
            _edits.Remove((row.ReferenceNo, type));
            return;
        }

        _edits[(row.ReferenceNo, type)] = newValue;
    }

    private static DateOnly? StoredDate(ShipmentRow row, MilestoneType type) => type switch
    {
        MilestoneType.Loading => row.LoadingDate,
        MilestoneType.DepartureCustomsClearance => row.DepartureCustomsClearanceDate,
        MilestoneType.Departure => row.DepartureDate,
        MilestoneType.ArrivalToTargetCountry => row.ArrivalToTargetCountryDate,
        MilestoneType.CustomsStart => row.CustomsStartDate,
        MilestoneType.CustomsEnd => row.CustomsEndDate,
        MilestoneType.CrossdockArrival => row.CrossdockArrivalDate,
        _ => null
    };

    private DateTime? TransferGet(string transferNo, MilestoneType type)
    {
        if (_edits.TryGetValue((transferNo, type), out var edited))
        {
            return edited?.ToDateTime(TimeOnly.MinValue);
        }

        var stored = _shipment?.Transfers.FirstOrDefault(t => t.TransferNo == transferNo)?.Milestones.GetValueOrDefault(type);
        return stored?.ToDateTime(TimeOnly.MinValue);
    }

    private void TransferSet(string transferNo, MilestoneType type, DateTime? value)
    {
        var newValue = value is null ? (DateOnly?)null : DateOnly.FromDateTime(value.Value);
        var stored = _shipment?.Transfers.FirstOrDefault(t => t.TransferNo == transferNo)?.Milestones.GetValueOrDefault(type);

        if (stored == newValue)
        {
            _edits.Remove((transferNo, type));
            return;
        }

        _edits[(transferNo, type)] = newValue;
    }

    private void ResetChanges()
    {
        _edits.Clear();
        _errors = [];
    }

    private async Task SaveAsync()
    {
        if (_edits.Count == 0)
        {
            return;
        }

        _busy = true;
        _errors = [];

        var changes = _edits.Select(edit => new MilestoneChange(edit.Key.Reference, edit.Key.Type, edit.Value));

        var result = await Milestones.ApplyAsync(changes, MilestoneApplyOptions.Manual, Permissions);
        _errors = [.. result.Errors];

        if (result.Applied > 0)
        {
            Snackbar.Add($"Saved {result.Applied} date{(result.Applied == 1 ? "" : "s")}.", Severity.Success);
        }

        if (result.HasErrors && result.Applied == 0)
        {
            Snackbar.Add("No dates were saved.", Severity.Error);
        }

        _edits.Clear();
        _busy = false;

        if (_grid is not null)
        {
            await _grid.ReloadServerData();
        }

        // Reload so status, performance and the transfer rollups reflect what was just written.
        if (_shipment is not null)
        {
            _shipment = await Query.GetShipmentDetailAsync(CountryId, Permissions, _shipment.ReferenceNo);
        }
    }
}
