@page "/{CountryCode}/shipments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CountryPageBase
@inject IShipmentQueryService Query

<PageTitle>Shipments · LTS</PageTitle>

@if (!Ready)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h5">Shipments</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Tracked from loading to crossdock arrival
        </MudText>
    </MudStack>

    <ShipmentFilterBar Permissions="Permissions" FilterChanged="OnFilterChangedAsync" />

    <MudDataGrid T="ShipmentRow" @ref="_grid" ServerData="LoadAsync" Dense="true" Hover="true" Striped="true"
                 Filterable="false" SortMode="SortMode.Single" RowsPerPage="50" Elevation="1"
                 FixedHeader="true" Height="calc(100vh - 320px)">
        <Columns>
            <PropertyColumn Property="x => x.ReferenceNo" Title="Reference No" />
            <PropertyColumn Property="x => x.InvoiceNo" Title="Invoice No" />
            <PropertyColumn Property="x => x.InvoiceDate" Title="Invoice Date" Format="yyyy-MM-dd" />

            <TemplateColumn Title="Current Status" SortBy="x => x.CurrentStatus">
                <CellTemplate><StatusChip Status="context.Item.CurrentStatus" /></CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Performance" SortBy="x => x.Performance">
                <CellTemplate><PerformanceChip Performance="context.Item.Performance" /></CellTemplate>
            </TemplateColumn>

            @* The seven shipment attributes. *@
            <PropertyColumn Property="x => x.ArrivalCountry" Title="Arrival Country" />
            <PropertyColumn Property="x => x.ArrivalCustoms" Title="Arrival Customs" />
            <PropertyColumn Property="x => x.ExportType" Title="Export Type" />
            <PropertyColumn Property="x => x.TransportType" Title="Transport Type" />
            <PropertyColumn Property="x => x.LoadingPoint" Title="Loading Point" />
            <PropertyColumn Property="x => x.LogisticsCompany" Title="Logistics Company" />
            <PropertyColumn Property="x => x.Broker" Title="Broker" />

            @* Milestone dates, in lifecycle order. *@
            <PropertyColumn Property="x => x.LoadingDate" Title="Loading" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.DepartureCustomsClearanceDate" Title="Export Clearance" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.DepartureDate" Title="Departure" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.ArrivalToTargetCountryDate" Title="Arrival To Country" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.CustomsStartDate" Title="Customs Start" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.CustomsEndDate" Title="Customs End" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.CrossdockArrivalDate" Title="Crossdock Arrival" Format="yyyy-MM-dd" />

            <PropertyColumn Property="x => x.TransferCount" Title="Transfers" />
            <PropertyColumn Property="x => x.TotalBoxes" Title="Boxes" />
            <PropertyColumn Property="x => x.TotalItems" Title="Items" />

            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudTooltip Text="Open details">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                       Href="@($"/{Country.CountryCode}/shipment-details?reference={context.Item.ReferenceNo}")" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ShipmentRow" PageSizeOptions="new[] { 25, 50, 100, 250 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4">No shipments match the current filters.</MudText>
        </NoRecordsContent>
    </MudDataGrid>
}

@code {
    protected override string PageKey => PageKeys.Shipments;

    private MudDataGrid<ShipmentRow>? _grid;
    private ShipmentFilter _filter = new();

    private async Task<GridData<ShipmentRow>> LoadAsync(GridState<ShipmentRow> state)
    {
        var sort = state.SortDefinitions.FirstOrDefault();

        var result = await Query.GetShipmentsAsync(
            CountryId,
            Permissions,
            _filter,
            new GridRequest(state.Page, state.PageSize, sort?.SortBy, sort?.Descending ?? false));

        return new GridData<ShipmentRow> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OnFilterChangedAsync(ShipmentFilter filter)
    {
        _filter = filter;

        // Filtering from page 4 would otherwise land on an empty page of a smaller result set.
        if (_grid is not null)
        {
            await _grid.ReloadServerData();
        }
    }

    protected override Task OnCountryReadyAsync() =>
        _grid is null ? Task.CompletedTask : _grid.ReloadServerData();
}
