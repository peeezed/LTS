@page "/{CountryCode}/shipments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout AppLayout
@inherits CountryPageBase
@inject IShipmentQueryService Query

<PageTitle>Shipments · LTS</PageTitle>

<AppShell>
@if (!Ready)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h5">Shipments</MudText>
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="_showKpi" Color="Color.Primary" Label="Show KPI columns" Class="mr-4" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Tracked from loading to crossdock arrival
        </MudText>
    </MudStack>

    <ShipmentFilterBar Permissions="Permissions" FilterChanged="OnFilterChangedAsync" />

    <MudDataGrid T="ShipmentRow" @ref="_grid" ServerData="LoadAsync" Dense="true" Hover="true" Striped="true"
                 Filterable="false" SortMode="SortMode.Single" RowsPerPage="50" Elevation="1"
                 FixedHeader="true" Height="calc(100vh - 320px)">
        <Columns>
            <PropertyColumn Property="x => x.ReferenceNo" Title="Reference No" />
            <PropertyColumn Property="x => x.InvoiceNo" Title="Invoice No" />
            <PropertyColumn Property="x => x.InvoiceDate" Title="Invoice Date" Format="yyyy-MM-dd" />

            <TemplateColumn Title="Current Status" SortBy="x => x.CurrentStatus">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <StatusChip Status="context.Item.CurrentStatus" />
                        @if (TransferProgressText(context.Item) is { } progress)
                        {
                            <MudTooltip Text="@progress">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                         Icon="@Icons.Material.Filled.LocalShipping">
                                    @MovedTransferCount(context.Item)
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Performance" SortBy="x => x.Performance">
                <CellTemplate><PerformanceChip Performance="context.Item.Performance" /></CellTemplate>
            </TemplateColumn>

            @* The seven shipment attributes. *@
            <PropertyColumn Property="x => x.ArrivalCountry" Title="Arrival Country" />
            <PropertyColumn Property="x => x.ArrivalCustoms" Title="Arrival Customs" />
            <PropertyColumn Property="x => x.ExportType" Title="Export Type" />
            <PropertyColumn Property="x => x.TransportType" Title="Transport Type" />
            <PropertyColumn Property="x => x.LoadingPoint" Title="Loading Point" />
            <PropertyColumn Property="x => x.LogisticsCompany" Title="Logistics Company" />
            <PropertyColumn Property="x => x.Broker" Title="Broker" />

            @*
                Milestone dates, in lifecycle order, each preceded by its KPI target/deadline pair -
                always rendered (never @if'd in/out - MudDataGrid re-appends a column at the end of
                the grid if it's added back after being removed, so toggling visibility has to use
                each column's own Hidden property instead of conditionally rendering the column itself).
                A KPI pair is named after the milestone it gates (e.g. "KPI Export Clearance" / "KPI
                Export Clearance Date" sit right before the "Export Clearance" column itself), styled
                distinctly (smaller, tinted) so they read as auxiliary to the actual dates.
            *@
            <PropertyColumn Property="x => x.LoadingDate" Title="Loading" Format="yyyy-MM-dd" />
            <TemplateColumn Title="KPI Export Clearance" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDaysText(context.Item.LoadingDate, context.Item.KPICustomsClearanceDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="KPI Export Clearance Date" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDateText(context.Item.KPICustomsClearanceDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Export Clearance" SortBy="x => x.DepartureCustomsClearanceDate">
                <CellTemplate>
                    <KpiDateCell ActualDate="context.Item.DepartureCustomsClearanceDate" Deadline="context.Item.KPICustomsClearanceDate" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="KPI Departure" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDaysText(context.Item.DepartureCustomsClearanceDate, context.Item.KPIDepartureDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="KPI Departure Date" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDateText(context.Item.KPIDepartureDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Departure" SortBy="x => x.DepartureDate">
                <CellTemplate>
                    <KpiDateCell ActualDate="context.Item.DepartureDate" Deadline="context.Item.KPIDepartureDate" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="KPI Arrival To Country" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDaysText(context.Item.DepartureDate, context.Item.KPIArrivalToDestinationDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="KPI Arrival To Country Date" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDateText(context.Item.KPIArrivalToDestinationDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Arrival To Country" SortBy="x => x.ArrivalToTargetCountryDate">
                <CellTemplate>
                    <KpiDateCell ActualDate="context.Item.ArrivalToTargetCountryDate" Deadline="context.Item.KPIArrivalToDestinationDate" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.CustomsStartDate" Title="Customs Start" Format="yyyy-MM-dd" />
            <TemplateColumn Title="KPI Customs End" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDaysText(context.Item.CustomsStartDate, context.Item.KPIArrivalCustomsEndDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="KPI Customs End Date" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDateText(context.Item.KPIArrivalCustomsEndDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Customs End" SortBy="x => x.CustomsEndDate">
                <CellTemplate>
                    <KpiDateCell ActualDate="context.Item.CustomsEndDate" Deadline="context.Item.KPIArrivalCustomsEndDate" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="KPI Crossdock Arrival" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDaysText(context.Item.CustomsEndDate, context.Item.KPILeadTimeToXdock)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="KPI Crossdock Arrival Date" Sortable="false" Hidden="@(!_showKpi)"
                             HeaderStyle="@KpiHeaderStyle" CellStyle="@KpiCellStyle">
                <CellTemplate>@KpiDateText(context.Item.KPILeadTimeToXdock)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Crossdock Arrival" SortBy="x => x.CrossdockArrivalDate">
                <CellTemplate>
                    <KpiDateCell ActualDate="context.Item.CrossdockArrivalDate" Deadline="context.Item.KPILeadTimeToXdock" />
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.TransferCount" Title="Transfers" />
            <PropertyColumn Property="x => x.TotalBoxes" Title="Boxes" />
            <PropertyColumn Property="x => x.TotalItems" Title="Items" />

            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudTooltip Text="Open details">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                       Href="@($"/{Country.CountryCode}/shipment-details?reference={context.Item.ReferenceNo}")" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ShipmentRow" PageSizeOptions="new[] { 25, 50, 100, 250 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4">No shipments match the current filters.</MudText>
        </NoRecordsContent>
    </MudDataGrid>
}
</AppShell>

@code {
    protected override string PageKey => PageKeys.Shipments;

    private MudDataGrid<ShipmentRow>? _grid;
    private ShipmentFilter _filter = new();

    /// <summary>Resets on every visit - no persisted preference exists yet for this.</summary>
    private bool _showKpi;

    // Tinted and smaller than the regular columns, so KPI columns read as auxiliary to the actual
    // milestone dates rather than equal citizens - rgba/CSS variables rather than a fixed hex so
    // this still reads correctly in both light and dark themes.
    private const string KpiHeaderStyle = "font-size: 0.7rem; background-color: rgba(33, 150, 243, 0.14);";
    private const string KpiCellStyle =
        "font-size: 0.75rem; background-color: rgba(33, 150, 243, 0.06); color: var(--mud-palette-text-secondary);";

    private static string KpiDaysText(DateOnly? start, DateOnly? deadline) =>
        IntegrationKpiDisplay.DaysBetween(start, deadline) is { } days ? $"{days}d" : "—";

    private static string KpiDateText(DateOnly? deadline) => deadline?.ToString("yyyy-MM-dd") ?? "—";

    private async Task<GridData<ShipmentRow>> LoadAsync(GridState<ShipmentRow> state)
    {
        var sort = state.SortDefinitions.FirstOrDefault();

        var result = await Query.GetShipmentsAsync(
            CountryId,
            Permissions,
            _filter,
            new GridRequest(state.Page, state.PageSize, sort?.SortBy, sort?.Descending ?? false));

        return new GridData<ShipmentRow> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task OnFilterChangedAsync(ShipmentFilter filter)
    {
        _filter = filter;

        // Filtering from page 4 would otherwise land on an empty page of a smaller result set.
        if (_grid is not null)
        {
            await _grid.ReloadServerData();
        }
    }

    protected override Task OnCountryReadyAsync() =>
        _grid is null ? Task.CompletedTask : _grid.ReloadServerData();

    /// <summary>
    /// How many of this shipment's transfers have moved past its own (crossdock-capped) status -
    /// the number shown on the badge next to the status chip. Zero when none have, in which case
    /// the badge is hidden entirely: the plain status chip already tells the whole story.
    /// </summary>
    private static int MovedTransferCount(ShipmentRow row) =>
        row.TransferStatusBreakdown.Where(b => b.Status > row.CurrentStatus).Sum(b => b.Count);

    /// <summary>The badge's tooltip: the full per-status transfer breakdown, or null to hide the badge.</summary>
    private static string? TransferProgressText(ShipmentRow row)
    {
        if (MovedTransferCount(row) == 0)
        {
            return null;
        }

        return string.Join(" · ", row.TransferStatusBreakdown.Select(b => $"{b.Count} {b.Status.ToDisplay()}"));
    }
}
