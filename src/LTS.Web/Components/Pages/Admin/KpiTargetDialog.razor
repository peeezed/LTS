@using LTS.Application.Kpi
@using LTS.Domain.Enums
@using LTS.Domain.Kpi

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="IntegrationKpiStep" @bind-Value="_step" Label="KPI Leg" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Required="true">
                    @foreach (var step in IntegrationKpiCatalog.All)
                    {
                        <MudSelectItem T="IntegrationKpiStep" Value="@step.Step">@step.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="string?" @bind-Value="_exportType" Label="Export type" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true" HelperText="Blank means any">
                    @foreach (var option in ExportTypes)
                    {
                        <MudSelectItem T="string?" Value="@option.Description">@option.Display</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="string?" @bind-Value="_loadingPoint" Label="Loading point" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true" HelperText="Blank means any">
                    @foreach (var option in LoadingPoints)
                    {
                        <MudSelectItem T="string?" Value="@option.Description">@option.Display</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="string?" @bind-Value="_arrivalCustoms" Label="Arrival customs" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true" HelperText="Blank means any">
                    @foreach (var option in ArrivalCustomsOptions)
                    {
                        <MudSelectItem T="string?" Value="@option.Description">@option.Display</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="string?" @bind-Value="_transportType" Label="Transport type" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true" HelperText="Blank means any">
                    @foreach (var option in TransportTypes)
                    {
                        <MudSelectItem T="string?" Value="@option.Description">@option.Display</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="_targetDays" Label="Target (days)" Min="0" Max="365"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_isActive" Label="Active" Color="Color.Primary" />
            </MudItem>
        </MudGrid>

        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            Editing this target only affects legs whose start date is entered from now on — it does not
            re-score a leg that has already been scored against the previous target.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public IntegrationKpiTargetRow? Row { get; set; }
    [Parameter] public IReadOnlyList<AttributeDto> ExportTypes { get; set; } = [];
    [Parameter] public IReadOnlyList<AttributeDto> LoadingPoints { get; set; } = [];
    [Parameter] public IReadOnlyList<AttributeDto> ArrivalCustomsOptions { get; set; } = [];
    [Parameter] public IReadOnlyList<AttributeDto> TransportTypes { get; set; } = [];

    private IntegrationKpiStep _step = IntegrationKpiStep.LoadingToCustomsClearance;
    private string? _exportType;
    private string? _loadingPoint;
    private string? _arrivalCustoms;
    private string? _transportType;
    private int _targetDays = 3;
    private bool _isActive = true;

    protected override void OnInitialized()
    {
        if (Row is null)
        {
            return;
        }

        _step = Row.Step;
        _exportType = Row.ExportType;
        _loadingPoint = Row.LoadingPoint;
        _arrivalCustoms = Row.ArrivalCustoms;
        _transportType = Row.TransportType;
        _targetDays = Row.TargetDays;
        _isActive = Row.IsActive;
    }

    private void Save() => Dialog.Close(DialogResult.Ok(new IntegrationKpiTargetInput
    {
        Id = Row?.Id,
        Step = _step,
        ExportType = _exportType,
        LoadingPoint = _loadingPoint,
        ArrivalCustoms = _arrivalCustoms,
        TransportType = _transportType,
        TargetDays = _targetDays,
        IsActive = _isActive
    }));

    private void Cancel() => Dialog.Cancel();
}
