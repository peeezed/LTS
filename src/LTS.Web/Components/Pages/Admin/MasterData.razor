@page "/{CountryCode}/admin/master-data"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout AppLayout
@inherits CountryPageBase
@inject IReferenceDataService Reference
@inject IMasterDataService Master
@inject ISnackbar Snackbar

<PageTitle>Master data · LTS</PageTitle>

<AppShell>
@if (!Ready)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5" Class="mb-1">Master Data</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        The reference data shipments are matched against. Integration payloads are matched to
        these by code, so a missing entry is what makes an import fail. Shared across every
        country, except Stores, which belongs to @Country.Current!.Name only.
    </MudText>

    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <MudTabPanel Text="Arrival customs" Icon="@Icons.Material.Filled.Gavel">
            <AttributeEditor Kind="AttributeKind.ArrivalCustoms" CanEdit="CanEdit"
                              Values="_arrivalCustoms" Saved="ReloadAsync"
                              Description="Customs offices shipments clear through on arrival." />
        </MudTabPanel>

        <MudTabPanel Text="Export types" Icon="@Icons.Material.Filled.Category">
            <AttributeEditor Kind="AttributeKind.ExportType" CanEdit="CanEdit"
                              Values="_exportTypes" Saved="ReloadAsync"
                              Description="Transit, direct transit, export, and so on." />
        </MudTabPanel>

        <MudTabPanel Text="Transport types" Icon="@Icons.Material.Filled.DirectionsBoat">
            <AttributeEditor Kind="AttributeKind.TransportType" CanEdit="CanEdit"
                              Values="_transportTypes" Saved="ReloadAsync"
                              Description="Road, sea, air, rail." />
        </MudTabPanel>

        <MudTabPanel Text="Loading points" Icon="@Icons.Material.Filled.Warehouse">
            <AttributeEditor Kind="AttributeKind.LoadingPoint" CanEdit="CanEdit"
                              Values="_loadingPoints" Saved="ReloadAsync"
                              Description="Where shipments are loaded before departure." />
        </MudTabPanel>

        <MudTabPanel Text="Logistics companies" Icon="@Icons.Material.Filled.LocalShipping">
            <AttributeEditor Kind="AttributeKind.LogisticsCompany" CanEdit="CanEdit"
                              Values="_logisticsCompanies" Saved="ReloadAsync"
                              Description="Carriers. A LogisticsCompany account is linked to one of these, which is what limits it to its own shipments." />
        </MudTabPanel>

        <MudTabPanel Text="Brokers" Icon="@Icons.Material.Filled.Business">
            <AttributeEditor Kind="AttributeKind.Broker" CanEdit="CanEdit"
                              Values="_brokers" Saved="ReloadAsync"
                              Description="Customs brokers. A Broker account is linked to one of these, which is what limits it to its own shipments." />
        </MudTabPanel>

        <MudTabPanel Text="Stores" Icon="@Icons.Material.Filled.Store">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Destinations for transfers in @Country.Current!.Name. A transfer whose store code is
                    unknown cannot be imported. City drives the Local Transportation KPI once targets can
                    be scoped by it.
                </MudText>
                <MudSpacer />
                @if (CanEdit)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditStore(null)">
                        Add
                    </MudButton>
                }
            </MudStack>

            <MudTable Items="_stores" Dense="true" Hover="true" Elevation="0" FixedHeader="true" Height="440px">
                <HeaderContent>
                    <MudTh>Code</MudTh><MudTh>Curr Acc Code</MudTh><MudTh>Description</MudTh><MudTh>City</MudTh>
                    <MudTh>Active</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Code</MudTd>
                    <MudTd>@context.CurrAccCode</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>@context.City</MudTd>
                    <MudTd><ActiveIcon IsActive="context.IsActive" /></MudTd>
                    <MudTd>
                        @if (CanEdit)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="() => EditStore(context)" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>

            @if (_editingStore is not null)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-3">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="3">
                            <MudTextField T="string" @bind-Value="_storeCode" Label="Code"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudTextField T="string" @bind-Value="_storeCurrAccCode" Label="Curr acc code"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="_storeDescription" Label="Description"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudSwitch T="bool" @bind-Value="_storeActive" Label="Active" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="_storeCity" Label="City"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" Class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveStoreAsync">Save</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="() => _editingStore = null">Cancel</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </MudTabPanel>
    </MudTabs>
}
</AppShell>

@code {
    protected override string PageKey => PageKeys.AdminMasterData;

    private IReadOnlyList<AttributeDto> _arrivalCustoms = [];
    private IReadOnlyList<AttributeDto> _exportTypes = [];
    private IReadOnlyList<AttributeDto> _transportTypes = [];
    private IReadOnlyList<AttributeDto> _loadingPoints = [];
    private IReadOnlyList<AttributeDto> _logisticsCompanies = [];
    private IReadOnlyList<AttributeDto> _brokers = [];
    private IReadOnlyList<StoreDto> _stores = [];

    private StoreDto? _editingStore;
    private string _storeCode = string.Empty;
    private string? _storeCurrAccCode;
    private string _storeDescription = string.Empty;
    private string? _storeCity;
    private bool _storeActive = true;

    protected override Task OnCountryReadyAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _arrivalCustoms = await Reference.GetIntegrationAttributesAsync(AttributeKind.ArrivalCustoms);
        _exportTypes = await Reference.GetIntegrationAttributesAsync(AttributeKind.ExportType);
        _transportTypes = await Reference.GetIntegrationAttributesAsync(AttributeKind.TransportType);
        _loadingPoints = await Reference.GetIntegrationAttributesAsync(AttributeKind.LoadingPoint);
        _logisticsCompanies = await Reference.GetIntegrationAttributesAsync(AttributeKind.LogisticsCompany);
        _brokers = await Reference.GetIntegrationAttributesAsync(AttributeKind.Broker);
        _stores = await Reference.GetStoresAsync(CountryId, activeOnly: false);
    }

    private void EditStore(StoreDto? store)
    {
        _editingStore = store ?? new StoreDto(0, string.Empty, null, string.Empty, null, CountryId, true);
        _storeCode = _editingStore.Code ?? string.Empty;
        _storeCurrAccCode = _editingStore.CurrAccCode;
        _storeDescription = _editingStore.Description ?? string.Empty;
        _storeCity = _editingStore.City;
        _storeActive = _editingStore.IsActive;
    }

    private async Task SaveStoreAsync()
    {
        try
        {
            await Master.SaveStoreAsync(new StoreInput(
                _editingStore!.Id == 0 ? null : _editingStore.Id,
                CountryId, _storeCode, _storeCurrAccCode, _storeDescription, _storeCity, _storeActive));

            _editingStore = null;
            Snackbar.Add("Store saved.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }
}
