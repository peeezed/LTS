@page "/{CountryCode}/admin/kpi"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout AppLayout
@inherits CountryPageBase
@using LTS.Application.Kpi
@using LTS.Domain.Kpi
@inject IKpiAdminService Kpi
@inject IReferenceDataService Reference
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>KPI targets · LTS</PageTitle>

<AppShell>
@if (!Ready)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudText Typo="Typo.h5">KPI Targets</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                   OnClick="ExportAsync" Class="mr-2">
            Export
        </MudButton>
        @if (CanEdit)
        {
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelectedAsync" Accept=".xlsx" MaximumFileCount="1"
                           Class="mr-2">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">
                        Import
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="() => EditAsync(null)">
                Add target
            </MudButton>
        }
    </MudStack>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Targets are given in days per step. Leave export type, loading country or arrival country blank to
        mean "any" — the most specific matching row is the one a shipment is scored against.
    </MudText>

    @if (_preview is not null)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.subtitle1">Import preview — @_preview.FileName</MudText>
                <MudSpacer />
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                    @_preview.ValidRows.Count valid
                </MudChip>
                @if (_preview.InvalidRows.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                        @_preview.InvalidRows.Count rejected
                    </MudChip>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-2"
                           Disabled="@(!_preview.CanImport)" OnClick="CommitImportAsync">
                    Apply import
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _preview = null">Cancel</MudButton>
            </MudStack>

            @foreach (var error in _preview.FileErrors)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@error</MudAlert>
            }

            <MudTable Items="_preview.Rows" Dense="true" Height="280px" FixedHeader="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Row</MudTh>
                    <MudTh>Target</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RowNumber</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>
                        @if (context.IsValid)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">OK</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error">@context.Error</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    <MudDataGrid T="KpiTargetRow" Items="_targets" Dense="true" Hover="true" Striped="true"
                 Groupable="true" SortMode="SortMode.Single" Elevation="1" RowsPerPage="50">
        <Columns>
            <PropertyColumn Property="x => x.StepName" Title="Step" Grouping="true" />
            <TemplateColumn Title="Export Type">
                <CellTemplate>@(context.Item.ExportType ?? "Any")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Loading Country">
                <CellTemplate>@(context.Item.LoadingCountryCode ?? "Any")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Arrival Country">
                <CellTemplate>@(context.Item.ArrivalCountry ?? "Any")</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.TargetDays" Title="Target (days)" />
            <PropertyColumn Property="x => x.EffectiveFrom" Title="Effective From" Format="yyyy-MM-dd" />
            <TemplateColumn Title="Effective To">
                <CellTemplate>@(context.Item.EffectiveTo?.ToString("yyyy-MM-dd") ?? "—")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Precedence">
                <CellTemplate>
                    <MudTooltip Text="How many keys this row pins down. Higher wins.">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Item.Specificity</MudChip>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Active">
                <CellTemplate>
                    <MudIcon Icon="@(context.Item.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)" Size="Size.Small" />
                </CellTemplate>
            </TemplateColumn>
            @if (CanEdit)
            {
                <TemplateColumn Title="" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="() => EditAsync(context.Item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteAsync(context.Item)" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            }
        </Columns>
        <PagerContent>
            <MudDataGridPager T="KpiTargetRow" />
        </PagerContent>
    </MudDataGrid>
}
</AppShell>

@code {
    protected override string PageKey => PageKeys.AdminKpi;

    private const long MaxUploadBytes = 5 * 1024 * 1024;

    private IReadOnlyList<KpiTargetRow> _targets = [];
    private IReadOnlyList<LookupDto> _exportTypes = [];
    private IReadOnlyList<CountryDto> _countries = [];
    private KpiImportPreview? _preview;

    protected override async Task OnCountryReadyAsync()
    {
        _exportTypes = await Reference.GetLookupsAsync(LookupKind.ExportType);
        _countries = await Reference.GetCountriesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _targets = await Kpi.GetTargetsAsync(CountryId);

    private async Task EditAsync(KpiTargetRow? row)
    {
        var parameters = new DialogParameters<KpiTargetDialog>
        {
            { x => x.Row, row },
            { x => x.ExportTypes, _exportTypes },
            { x => x.Countries, _countries },
            { x => x.DefaultArrivalCountryId, CountryId }
        };

        var dialog = await Dialogs.ShowAsync<KpiTargetDialog>(
            row is null ? "Add KPI target" : "Edit KPI target", parameters);

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not KpiTargetInput input)
        {
            return;
        }

        try
        {
            await Kpi.SaveAsync(input);
            Snackbar.Add("KPI target saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(KpiTargetRow row)
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Delete KPI target",
            $"Delete the {row.TargetDays} day target for {row.StepName}? Shipments will be re-scored without it.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        await Kpi.DeleteAsync(row.Id);
        Snackbar.Add("KPI target deleted.", Severity.Success);
        await LoadAsync();
    }

    private async Task ExportAsync()
    {
        var bytes = await Kpi.ExportAsync(CountryId);
        await JS.InvokeVoidAsync("ltsDownload", $"LTS-kpi-targets-{Country.CountryCode}.xlsx",
            Convert.ToBase64String(bytes));
    }

    private async Task OnFileSelectedAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        using var buffer = new MemoryStream();
        await using (var source = file.OpenReadStream(MaxUploadBytes))
        {
            await source.CopyToAsync(buffer);
        }

        buffer.Position = 0;
        _preview = await Kpi.ParseAsync(buffer, file.Name);
    }

    private async Task CommitImportAsync()
    {
        if (_preview is null)
        {
            return;
        }

        var result = await Kpi.CommitAsync(_preview);

        Snackbar.Add($"Imported {result.Created} new and {result.Updated} updated target(s).", Severity.Success);

        foreach (var error in result.Errors)
        {
            Snackbar.Add(error, Severity.Error);
        }

        _preview = null;
        await LoadAsync();
    }
}
