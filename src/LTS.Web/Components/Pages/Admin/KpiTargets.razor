@page "/{CountryCode}/admin/kpi"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout AppLayout
@inherits CountryPageBase
@using LTS.Application.Kpi
@using LTS.Domain.Kpi
@inject IIntegrationKpiAdminService Kpi
@inject IReferenceDataService Reference
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>KPI targets · LTS</PageTitle>

<AppShell>
@if (!Ready)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudText Typo="Typo.h5">KPI Targets</MudText>
        <MudSpacer />
        @if (CanEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="() => EditAsync(null)">
                Add target
            </MudButton>
        }
    </MudStack>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Targets are given in days per KPI leg, for @Country.CountryCode only. Leave an attribute blank to
        mean "any" — the most specific matching row is the one a shipment is scored against.
    </MudText>

    <MudDataGrid T="IntegrationKpiTargetRow" Items="_targets" Dense="true" Hover="true" Striped="true"
                 Groupable="true" SortMode="SortMode.Single" Elevation="1" RowsPerPage="50">
        <Columns>
            <PropertyColumn Property="x => x.StepName" Title="KPI Leg" Grouping="true" />
            <TemplateColumn Title="Export Type">
                <CellTemplate>@(context.Item.ExportType ?? "Any")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Loading Point">
                <CellTemplate>@(context.Item.LoadingPoint ?? "Any")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Arrival Customs">
                <CellTemplate>@(context.Item.ArrivalCustoms ?? "Any")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Transport Type">
                <CellTemplate>@(context.Item.TransportType ?? "Any")</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.TargetDays" Title="Target (days)" />
            <TemplateColumn Title="Precedence">
                <CellTemplate>
                    <MudTooltip Text="How many attributes this row pins down. Higher wins.">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Item.Specificity</MudChip>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Active">
                <CellTemplate>
                    <MudIcon Icon="@(context.Item.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)" Size="Size.Small" />
                </CellTemplate>
            </TemplateColumn>
            @if (CanEdit)
            {
                <TemplateColumn Title="" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="0">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="() => EditAsync(context.Item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteAsync(context.Item)" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            }
        </Columns>
        <PagerContent>
            <MudDataGridPager T="IntegrationKpiTargetRow" />
        </PagerContent>
    </MudDataGrid>
}
</AppShell>

@code {
    protected override string PageKey => PageKeys.AdminKpi;

    private IReadOnlyList<IntegrationKpiTargetRow> _targets = [];
    private IReadOnlyList<AttributeDto> _exportTypes = [];
    private IReadOnlyList<AttributeDto> _loadingPoints = [];
    private IReadOnlyList<AttributeDto> _arrivalCustoms = [];
    private IReadOnlyList<AttributeDto> _transportTypes = [];

    protected override async Task OnCountryReadyAsync()
    {
        _exportTypes = await Reference.GetIntegrationAttributesAsync(AttributeKind.ExportType);
        _loadingPoints = await Reference.GetIntegrationAttributesAsync(AttributeKind.LoadingPoint);
        _arrivalCustoms = await Reference.GetIntegrationAttributesAsync(AttributeKind.ArrivalCustoms);
        _transportTypes = await Reference.GetIntegrationAttributesAsync(AttributeKind.TransportType);
        await LoadAsync();
    }

    private async Task LoadAsync() => _targets = await Kpi.GetTargetsAsync(CountryId);

    private async Task EditAsync(IntegrationKpiTargetRow? row)
    {
        var parameters = new DialogParameters<KpiTargetDialog>
        {
            { x => x.Row, row },
            { x => x.ExportTypes, _exportTypes },
            { x => x.LoadingPoints, _loadingPoints },
            { x => x.ArrivalCustomsOptions, _arrivalCustoms },
            { x => x.TransportTypes, _transportTypes }
        };

        var dialog = await Dialogs.ShowAsync<KpiTargetDialog>(
            row is null ? "Add KPI target" : "Edit KPI target", parameters);

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not IntegrationKpiTargetInput input)
        {
            return;
        }

        try
        {
            await Kpi.SaveAsync(CountryId, input);
            Snackbar.Add("KPI target saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(IntegrationKpiTargetRow row)
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Delete KPI target",
            $"Delete the {row.TargetDays} day target for {row.StepName}? Shipments will be re-scored without it.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        await Kpi.DeleteAsync(row.Id);
        Snackbar.Add("KPI target deleted.", Severity.Success);
        await LoadAsync();
    }
}
