@* Whether a reference-data row is still in use. Retired values are kept rather than deleted,
   because shipments already reference them. *@

<MudIcon Icon="@(IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
         Color="@(IsActive ? Color.Success : Color.Default)" Size="Size.Small" />

@code {
    [Parameter] public bool IsActive { get; set; }
}
