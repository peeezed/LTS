@inject IMasterDataService MasterData
@inject ISnackbar Snackbar

@* Inline editor for one of the simple code/name attribute lists. All three behave identically,
   so they share this rather than three near-copies of the same table. *@

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Description</MudText>
    <MudSpacer />
    @if (CanEdit)
    {
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="() => Edit(null)">
            Add
        </MudButton>
    }
</MudStack>

<MudTable Items="Values" Dense="true" Hover="true" Elevation="0">
    <HeaderContent>
        <MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Order</MudTh><MudTh>Active</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Code</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.SortOrder</MudTd>
        <MudTd><ActiveIcon IsActive="context.IsActive" /></MudTd>
        <MudTd>
            @if (CanEdit)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Edit(context)" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-3">Nothing defined yet.</MudText>
    </NoRecordsContent>
</MudTable>

@if (_editing is not null)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-3">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudTextField T="string" @bind-Value="_code" Label="Code" Variant="Variant.Outlined"
                              Margin="Margin.Dense" HelperText="Matched against integration payloads" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudNumericField T="int" @bind-Value="_sortOrder" Label="Order" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudSwitch T="bool" @bind-Value="_isActive" Label="Active" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" Class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _editing = null">Cancel</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public LookupKind Kind { get; set; }

    /// <summary>Null for lists that are shared across every country.</summary>
    [Parameter] public int? CountryId { get; set; }

    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public IReadOnlyList<LookupDto> Values { get; set; } = [];
    [Parameter] public string? Description { get; set; }

    /// <summary>Raised after a save so the parent can reload every list it owns.</summary>
    [Parameter] public EventCallback Saved { get; set; }

    private LookupDto? _editing;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private int _sortOrder;
    private bool _isActive = true;

    private void Edit(LookupDto? value)
    {
        // A new value goes to the end of the list rather than fighting for position 0.
        _editing = value ?? new LookupDto(0, string.Empty, string.Empty, Kind, CountryId, Values.Count + 1, true);
        _code = _editing.Code;
        _name = _editing.Name;
        _sortOrder = _editing.SortOrder;
        _isActive = _editing.IsActive;
    }

    private async Task SaveAsync()
    {
        try
        {
            await MasterData.SaveLookupAsync(new LookupInput(
                _editing!.Id == 0 ? null : _editing.Id,
                Kind, CountryId, _code, _name, _sortOrder, _isActive));

            _editing = null;
            Snackbar.Add("Saved.", Severity.Success);
            await Saved.InvokeAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }
}
