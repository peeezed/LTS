@inject IMasterDataService MasterData
@inject ISnackbar Snackbar

@* Inline editor for one of LTS_Integration's Code+Description shipment attribute tables. All six
   behave identically, so they share this rather than six near-copies of the same table. *@

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Description</MudText>
    <MudSpacer />
    @if (CanEdit)
    {
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="() => Edit(null)">
            Add
        </MudButton>
    }
</MudStack>

<MudTable Items="Values" Dense="true" Hover="true" Elevation="0">
    <HeaderContent>
        <MudTh>Code</MudTh><MudTh>Description</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Code</MudTd>
        <MudTd>@context.Description</MudTd>
        <MudTd>
            @if (CanEdit)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Edit(context)" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-3">Nothing defined yet.</MudText>
    </NoRecordsContent>
</MudTable>

@if (_editing is not null)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-3">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudTextField T="string" @bind-Value="_code" Label="Code" Variant="Variant.Outlined"
                              Margin="Margin.Dense" HelperText="Matched against integration payloads" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_description" Label="Description" Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" Class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _editing = null">Cancel</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public AttributeKind Kind { get; set; }

    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public IReadOnlyList<AttributeDto> Values { get; set; } = [];
    [Parameter] public string? Description { get; set; }

    /// <summary>Raised after a save so the parent can reload every list it owns.</summary>
    [Parameter] public EventCallback Saved { get; set; }

    private AttributeDto? _editing;
    private string _code = string.Empty;
    private string _description = string.Empty;

    private void Edit(AttributeDto? value)
    {
        _editing = value ?? new AttributeDto(0, string.Empty, string.Empty);
        _code = _editing.Code;
        _description = _editing.Description;
    }

    private async Task SaveAsync()
    {
        try
        {
            await MasterData.SaveIntegrationAttributeAsync(Kind, new AttributeInput(
                _editing!.Id == 0 ? null : _editing.Id, _code, _description));

            _editing = null;
            Snackbar.Add("Saved.", Severity.Success);
            await Saved.InvokeAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }
}
